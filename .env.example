# Application Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Container Credentials
MONGO_INITDB_ROOT_USERNAME=trustadmin
MONGO_INITDB_ROOT_PASSWORD=trustpassword
MONGO_INITDB_DATABASE=trustvault

# MongoDB Connection URI
MONGODB_URI=mongodb://trustadmin:trustpassword@127.0.0.1:27017/trustvault?authSource=admin

# Session Security Secret
SESSION_SECRET=trustvault-dev-session-secret-change-in-production-at-least-32-chars

# Seed User Passwords (Optional overrides)
SEED_ADMIN_PASSWORD=AdminVault2026!
SEED_OWNER_PASSWORD=OwnerVault2026!
SEED_VIEWER_PASSWORD=ViewerVault2026!
