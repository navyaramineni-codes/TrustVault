# Application Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Container Credentials
MONGO_INITDB_ROOT_USERNAME=trustadmin
MONGO_INITDB_ROOT_PASSWORD=trustpassword
MONGO_INITDB_DATABASE=trustvault

# MongoDB Connection URI
MONGODB_URI=mongodb://trustadmin:trustpassword@127.0.0.1:27017/trustvault?authSource=admin
