{
  "name": "trustvault",
  "version": "1.0.0",
  "description": "TrustVault secure document storage and authorization platform",
  "main": "backend/src/server.js",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend test",
    "backend:start": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "backend:seed": "npm --prefix backend run seed",
    "backend:test": "npm --prefix backend test",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "file-type": "^16.5.4",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  },
  "license": "ISC"
}
